+            cursor.execute(f"SELECT COUNT(*) FROM db_user WHERE name = '{user.upper()}'")
+            if cursor.fetchall()[0][0]:
+                cursor.execute(f"DROP USER {user}")
+            admin.commit()
+            admin.close()
